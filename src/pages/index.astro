---
import Layout from '../layouts/Layout.astro';
import NavigatorIsland from '../components/navigator/NavigatorIsland.jsx';
import ThemeToggle from '../components/theme/ThemeToggle.jsx';
import { sections } from '../data/sections.js';
import { Content as Header } from '../content/header.md';
import { Content as Me } from '../content/me.md';
import { Content as Experience } from '../content/experience.md';
import { Content as Skills } from '../content/skills.md';
import { Content as Education } from '../content/education.md';
import { Content as Footer } from '../content/footer.md';
import ExperienceCard from '../components/experience/ExperienceCard.astro';
import PortfolioProjects from '../components/portfolio/PortfolioProjects.astro';
import { experienceJobs } from '../data/experience.js';
import { portfolioProjects } from '../data/portfolio.js';

const contentById = {
  header: Header,
  me: Me,
  skills: Skills,
  experience: Experience,
  education: Education,
  footer: Footer,
};

const articles = sections.map(({ id }) => ({ id, Content: contentById[id] }));

const groups = [];
for (const article of articles) {
  if (article.id.startsWith('portfolio-')) {
    const last = groups[groups.length - 1];
    if (last?.kind === 'portfolio') last.items.push(article);
    else groups.push({ kind: 'portfolio', items: [article] });
  } else {
    groups.push({ kind: 'section', ...article });
  }
}
---

<Layout>
  <div class="shell">
    <header class="chrome">
      <div class="chrome-bar">
        <span class="logo" aria-hidden="true"></span>
        <span class="logo" aria-hidden="true"></span>
        <span class="logo" aria-hidden="true"></span>
        <span class="logo" aria-hidden="true"></span>
        <ThemeToggle client:load />
      </div>
    </header>
    <span class="mobile-header-logo">
      <span class="mobile-header-logo-mark"></span>
      <span class="mobile-header-logo-label">
        <span class="mobile-header-logo-kicker"></span>
        <span class="mobile-header-logo-name"></span>
      </span>
    </span>
    <button type="button" class="mobile-header-overlay" aria-label="Close menu"></button>
    <div class="stage">
      <div class="stage-helix">
        <NavigatorIsland client:load sections={sections} />
      </div>
      <main class="content">
        <div class="content-track">
          {groups.map((group) => {
            if (group.kind === 'portfolio') {
              return (
                <div class="portfolio-block">
                  <h1 class="portfolio-heading">Portfolio</h1>
                  <div class="portfolio-chrome">
                    <div class="portfolio-tabs" role="tablist" aria-label="Portfolio">
                      {group.items.map(({ id }, index) => (
                        <button
                          type="button"
                          class="portfolio-tab"
                          role="tab"
                          data-portfolio-target={id}
                          style={`--tab-index: ${index}`}
                        >
                          {sections.find((section) => section.id === id)?.title ?? ''}
                        </button>
                      ))}
                    </div>
                    <h1 class="portfolio-title"><span>Portfolio</span></h1>
                  </div>
                  <div class="portfolio-stick-mask" aria-hidden="true"></div>
                  {group.items.map(({ id }) => (
                    <section id={id}>
                      <PortfolioProjects projects={portfolioProjects[id]} />
                    </section>
                  ))}
                </div>
              );
            }
            const { id, Content } = group;
            if (id === 'experience') {
              return (
                <section id={id}>
                  <Content />
                  <div class="experience-list">
                    {experienceJobs.map((job) => (
                      <ExperienceCard {...job} />
                    ))}
                  </div>
                  <script>
                    const closePoints = (except) => {
                      document.querySelectorAll('.experience-points[open]').forEach((details) => {
                        if (details !== except) details.open = false;
                      });
                    };

                    document.addEventListener('click', (event) => {
                      const target = event.target instanceof Element ? event.target : null;
                      if (target?.closest('#experience a[href="#"]')) event.preventDefault();
                      if (target?.closest('.experience-points-close')) {
                        closePoints(null);
                        return;
                      }
                      closePoints(target?.closest('.experience-points') ?? null);
                    });

                    document.addEventListener('keydown', (event) => {
                      if (event.key === 'Escape') closePoints(null);
                    });

                    document.querySelectorAll('.experience-points').forEach((details) => {
                      const output = details.querySelector('.experience-points-output');
                      details.addEventListener('toggle', () => {
                        output.classList.remove('is-typing');
                        if (!details.open) return;
                        requestAnimationFrame(() => {
                          void output.offsetWidth;
                          output.classList.add('is-typing');
                        });
                      });
                    });
                  </script>
                </section>
              );
            }
            return (
              <section id={id}>
                <Content />
              </section>
            );
          })}
        </div>
      </main>
    </div>
    <div class="scroll-spacer" aria-hidden="true"></div>
    <dialog class="project-dialog" id="project-dialog">
      <button type="button" class="project-dialog-close" aria-label="Close">[x]</button>
      <div class="project-dialog-copy">
        <h2 class="project-dialog-title"></h2>
        <p class="project-dialog-line"></p>
      </div>
      <div class="project-dialog-frame">
        <button type="button" class="project-carousel-nav" data-dir="-1" aria-label="Previous image"></button>
        <img alt="" />
        <button type="button" class="project-carousel-nav" data-dir="1" aria-label="Next image"></button>
      </div>
    </dialog>
    <script is:inline>
      (() => {
        const skillCloud = document.querySelector('.skill-cloud');
        if (!skillCloud) return;
        const entries = [];
        const measure = () => {
          const prev = new Map(entries.map((entry) => [entry.item, entry]));
          const items = [...skillCloud.querySelectorAll('li:not(.skill-cloud-lead):not(.skill-cloud-title)')];
          const rows = [];
          items.forEach((item) => {
            const mid = item.offsetTop + item.offsetHeight / 2;
            const left = item.offsetLeft;
            const row = rows.find((entry) => Math.abs(entry.mid - mid) < 22);
            if (row) {
              row.items.push({ item, left });
              row.mid = (row.mid * (row.items.length - 1) + mid) / row.items.length;
            } else {
              rows.push({ mid, items: [{ item, left }] });
            }
          });
          rows.sort((a, b) => a.mid - b.mid);
          const rowDenom = Math.max(rows.length - 1, 1);
          entries.length = 0;
          rows.forEach((row, rowIndex) => {
            row.items.sort((a, b) => a.left - b.left);
            const colDenom = Math.max(row.items.length - 1, 1);
            row.items.forEach(({ item }, colIndex) => {
              const d = (rowIndex / rowDenom + (1 - colIndex / colDenom)) / 2;
              const old = prev.get(item);
              const emoji = old?.emoji ?? item.querySelector('.skill-emoji');
              const state = {
                item,
                emoji,
                d,
                hover: old?.hover ?? 0,
                hovered: old?.hovered ?? false,
              };
              item.onpointerenter = () => {
                state.hovered = true;
              };
              item.onpointerleave = () => {
                state.hovered = false;
              };
              entries.push(state);
            });
          });
        };
        measure();
        document.fonts?.ready.then(measure);
        new ResizeObserver(measure).observe(skillCloud);

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const halfWidth = 0.22;
        const pad = 0.14;
        const duration = 3200;
        let lastTime = performance.now();
        const tick = (now) => {
          const dt = Math.min((now - lastTime) / 1000, 0.1);
          lastTime = now;
          const progress = (now % duration) / duration;
          const center = -pad + progress * (1 + pad * 2);
          entries.forEach((entry) => {
            const targetHover = entry.hovered ? 1 : 0;
            const hoverRate = entry.hovered ? 12 : 1.6;
            entry.hover += (targetHover - entry.hover) * Math.min(1, dt * hoverRate);
            if (Math.abs(targetHover - entry.hover) < 0.002) entry.hover = targetHover;
            let wave = 0.22;
            if (!reduceMotion.matches) {
              const dist = Math.abs(entry.d - center) / halfWidth;
              if (dist < 1) {
                wave = 0.22 + 0.68 * 0.5 * (1 + Math.cos(Math.PI * dist));
              }
            }
            const opacity = wave + (1 - wave) * entry.hover;
            const color = Math.max((wave - 0.22) / 0.68, entry.hover);
            entry.item.style.opacity = opacity.toFixed(3);
            if (entry.emoji) {
              entry.emoji.style.filter = `grayscale(${(1 - color).toFixed(3)})`;
            }
          });
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      })();
    </script>
  </div>
</Layout>
