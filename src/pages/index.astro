---
import Layout from '../layouts/Layout.astro';
import NavigatorIsland from '../components/navigator/NavigatorIsland.jsx';
import ThemeToggle from '../components/theme/ThemeToggle.jsx';
import { sections } from '../data/sections.js';
import { Content as Header } from '../content/header.md';
import { Content as Me } from '../content/me.md';
import { Content as Experience } from '../content/experience.md';
import { Content as Skills } from '../content/skills.md';
import { Content as Portfolio1 } from '../content/portfolio.md';
import { Content as Portfolio2 } from '../content/portfolio-2.md';
import { Content as Portfolio3 } from '../content/portfolio-3.md';
import { Content as Portfolio4 } from '../content/portfolio-4.md';
import { Content as Education } from '../content/education.md';
import { Content as Footer } from '../content/footer.md';
import ExperienceCard from '../components/experience/ExperienceCard.astro';
import { experienceJobs } from '../data/experience.js';

const contentById = {
  header: Header,
  me: Me,
  skills: Skills,
  experience: Experience,
  'portfolio-1': Portfolio1,
  'portfolio-2': Portfolio2,
  'portfolio-3': Portfolio3,
  'portfolio-4': Portfolio4,
  education: Education,
  footer: Footer,
};

const articles = sections.map(({ id }) => ({ id, Content: contentById[id] }));

const groups = [];
for (const article of articles) {
  if (article.id.startsWith('portfolio-')) {
    const last = groups[groups.length - 1];
    if (last?.kind === 'portfolio') last.items.push(article);
    else groups.push({ kind: 'portfolio', items: [article] });
  } else {
    groups.push({ kind: 'section', ...article });
  }
}
---

<Layout>
  <div class="shell">
    <header class="chrome">
      <div class="chrome-bar">
        <span class="logo" aria-hidden="true"></span>
        <span class="logo" aria-hidden="true"></span>
        <span class="logo" aria-hidden="true"></span>
        <span class="logo" aria-hidden="true"></span>
        <ThemeToggle client:load />
      </div>
    </header>
    <span class="mobile-header-logo">
      <span class="mobile-header-logo-mark"></span>
      <span class="mobile-header-logo-label">
        <span class="mobile-header-logo-kicker"></span>
        <span class="mobile-header-logo-name"></span>
      </span>
    </span>
    <button type="button" class="mobile-header-overlay" aria-label="Close menu"></button>
    <div class="stage">
      <div class="stage-helix">
        <NavigatorIsland client:load sections={sections} />
      </div>
      <main class="content">
        <div class="content-track">
          {groups.map((group) => {
            if (group.kind === 'portfolio') {
              return (
                <div class="portfolio-block">
                  <h1 class="portfolio-title"><span>Portfolio</span></h1>
                  {group.items.map(({ id, Content }, index) => (
                    <section id={id} style={`--tab-index: ${index}`}>
                      <button type="button" class="portfolio-tab">{sections.find((section) => section.id === id)?.title ?? ''}</button>
                      <Content />
                    </section>
                  ))}
                </div>
              );
            }
            const { id, Content } = group;
            if (id === 'experience') {
              return (
                <section id={id}>
                  <Content />
                  <div class="experience-list">
                    {experienceJobs.map((job) => (
                      <ExperienceCard {...job} />
                    ))}
                  </div>
                  <form class="experience-colors">
                    <label>Title <input type="color" data-var="--exp-title" value="#ffffff" /></label>
                    <label>Company <input type="color" data-var="--exp-org" value="#34c4dd" /></label>
                    <label>Field <input type="color" data-var="--exp-field" value="#2b727c" /></label>
                    <label>Dates <input type="color" data-var="--exp-date" value="#ffffff" /></label>
                    <label>Roles <input type="color" data-var="--exp-role" value="#9adce8" /></label>
                    <label>Secondary lines <input type="color" data-var="--exp-plain" value="#9adce8" /></label>
                    <label>Bullet headings <input type="color" data-var="--exp-heading" value="#9adce8" /></label>
                    <label>Bullets <input type="color" data-var="--exp-bullet" value="#9adce8" /></label>
                    <label>Links <input type="color" data-var="--exp-link" value="#9adce8" /></label>
                  </form>
                  <script>
                    const experience = document.getElementById('experience');
                    document.querySelectorAll('.experience-colors input').forEach((input) => {
                      input.addEventListener('input', () => {
                        experience.style.setProperty(input.dataset.var, input.value);
                      });
                    });

                    const closePoints = (except) => {
                      document.querySelectorAll('.experience-points[open]').forEach((details) => {
                        if (details !== except) details.open = false;
                      });
                    };

                    document.addEventListener('click', (event) => {
                      const target = event.target instanceof Element ? event.target : null;
                      if (target?.closest('.experience-points-close')) {
                        closePoints(null);
                        return;
                      }
                      closePoints(target?.closest('.experience-points') ?? null);
                    });

                    document.addEventListener('keydown', (event) => {
                      if (event.key === 'Escape') closePoints(null);
                    });

                    document.querySelectorAll('.experience-points').forEach((details) => {
                      const output = details.querySelector('.experience-points-output');
                      details.addEventListener('toggle', () => {
                        output.classList.remove('is-typing');
                        if (!details.open) return;
                        requestAnimationFrame(() => {
                          void output.offsetWidth;
                          output.classList.add('is-typing');
                        });
                      });
                    });
                  </script>
                </section>
              );
            }
            return (
              <section id={id}>
                <Content />
              </section>
            );
          })}
        </div>
      </main>
    </div>
    <div class="scroll-spacer" aria-hidden="true"></div>
  </div>
</Layout>
