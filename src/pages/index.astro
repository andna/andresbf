---
import Layout from '../layouts/Layout.astro';
import NavigatorIsland from '../components/navigator/NavigatorIsland.jsx';
import ThemeToggle from '../components/theme/ThemeToggle.jsx';
import { sections } from '../data/sections.js';
import { Content as Header } from '../content/header.md';
import { Content as Me } from '../content/me.md';
import { Content as Experience } from '../content/experience.md';
import { Content as Skills } from '../content/skills.md';
import { Content as Portfolio1 } from '../content/portfolio.md';
import { Content as Portfolio2 } from '../content/portfolio-2.md';
import { Content as Portfolio3 } from '../content/portfolio-3.md';
import { Content as Portfolio4 } from '../content/portfolio-4.md';
import { Content as Education } from '../content/education.md';
import { Content as Footer } from '../content/footer.md';

const contentById = {
  header: Header,
  me: Me,
  skills: Skills,
  experience: Experience,
  'portfolio-1': Portfolio1,
  'portfolio-2': Portfolio2,
  'portfolio-3': Portfolio3,
  'portfolio-4': Portfolio4,
  education: Education,
  footer: Footer,
};

const articles = sections.map(({ id }) => ({ id, Content: contentById[id] }));
---

<Layout>
  <div class="shell">
    <header class="chrome">
      <div class="chrome-bar">
        <a class="logo" href="/" aria-label="andbastf"></a>
        <ThemeToggle client:load />
      </div>
    </header>
    <div class="stage">
      <div class="stage-helix">
        <NavigatorIsland client:load sections={sections} />
      </div>
      <main class="content">
        <div class="content-track">
          {articles.map(({ id, Content }) => (
            <section id={id}>
              <Content />
            </section>
          ))}
        </div>
      </main>
    </div>
    <div class="scroll-spacer" aria-hidden="true"></div>
  </div>
</Layout>
