---
import Layout from '../layouts/Layout.astro';
import NavigatorIsland from '../components/navigator/NavigatorIsland.jsx';
import ThemeToggle from '../components/theme/ThemeToggle.jsx';
import { sections } from '../data/sections.js';
import { Content as Me } from '../content/me.md';
import { Content as Experience } from '../content/experience.md';
import { Content as Skills } from '../content/skills.md';
import { Content as Portfolio } from '../content/portfolio.md';
import { Content as Education } from '../content/education.md';

const articles = [
  { id: 'me', Content: Me },
  { id: 'experience', Content: Experience },
  { id: 'skills', Content: Skills },
  { id: 'portfolio', Content: Portfolio },
  { id: 'education', Content: Education },
];
---

<Layout>
  <div class="shell">
    <header class="chrome">
      <div class="chrome-bar">
        <a class="logo" href="/" aria-label="andbastf"></a>
        <ThemeToggle client:load />
      </div>
      <div class="chrome-nav">
        <NavigatorIsland client:visible sections={sections} />
      </div>
    </header>
    <main class="content">
      {articles.map(({ id, Content }) => (
        <section id={id}>
          <Content />
        </section>
      ))}
    </main>
  </div>
</Layout>
