---
const { name, url = '', field, logo = false, entries, points = [], side = null, nested = false } = Astro.props;
const split = points.length > 0 || Boolean(side);
const present = entries.some((entry) => entry.type === 'start' && entry.label === 'Present');
const shortShaft = present && entries[1]?.type === 'role' && entries[1].lines.length === 1 && Boolean(entries[1].end);
const logoUrl = logo === true ? '/logo-a.svg' : logo || '';
const grouped = points.some((point) => typeof point === 'object' && point.items);
const groupOffsets = grouped ? points.map((_, index) => points.slice(0, index).reduce((sum, group) => sum + group.items.length + 1, 0)) : [];
---

<div class:list={['experience-card', { 'experience-card-split': split, 'experience-card-nested': nested }]}>
  <div class="experience-body">
  <div class="experience-head">
    {logoUrl && <span class:list={['experience-logo', { 'experience-logo-mark': logo !== true }]} style={`--experience-logo: url("${logoUrl}")`} aria-hidden="true"></span>}
    <div class="experience-org">
      <h2 class="experience-org-name">{url ? <a href={url} target="_blank" rel="noopener noreferrer">{name}</a> : name}</h2>
      {field && <p class="experience-org-field">{field}</p>}
    </div>
  </div>
  <ol class:list={['experience-track', { 'experience-shaft-short': shortShaft }]}>
    <li class:list={['experience-mark', { 'experience-mark-present': present }]}>
      <span class="experience-arrow" aria-hidden="true">
        {present && (
          <svg viewBox="0 0 16 11" aria-hidden="true">
            <polyline points="5,10.2 0.9,10.2 8,0.75 15.1,10.2 11,10.2" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linejoin="miter" stroke-linecap="butt" />
          </svg>
        )}
      </span>
    </li>
    {entries.map((entry) => {
      if (entry.type === 'start') {
        return (
          <li class:list={['experience-mark', 'experience-mark-fill', { 'experience-mark-present': entry.label === 'Present' }]}>
            <time class="experience-when" datetime={entry.datetime}>{entry.label}</time>
            <span class="experience-spine" aria-hidden="true"></span>
          </li>
        );
      }
      if (entry.type === 'tick') {
        return (
          <li class="experience-step experience-tick">
            <span class="experience-spine" aria-hidden="true"></span>
          </li>
        );
      }
      if (entry.type === 'gap') {
        return (
          <li class="experience-mark">
            <time class="experience-when" datetime={entry.datetime}>{entry.label}</time>
          </li>
        );
      }
      return (
        <li class:list={['experience-step', { 'experience-step-range': entry.end }]}>
          {entry.end && (
            <time class="experience-when" datetime={entry.end.datetime}>{entry.end.label}</time>
          )}
          <span class="experience-spine" aria-hidden="true"></span>
          <p class="experience-role">
            <span>
              {entry.lines.map((line, index) => {
                const text = typeof line === 'string' ? line : line.text;
                const plain = typeof line === 'object' && line.plain;
                const parts = typeof line === 'object' && line.parts;
                const href = typeof line === 'object' && line.href;
                return (
                  <>
                    {index > 0 && <br />}
                    {parts
                      ? parts.map((part) => (typeof part === 'string' ? part : <span class:list={{ 'experience-role-small': part.small }}>{part.text}</span>))
                      : href ? <a class="experience-role-link" href={href} target="_blank" rel="noopener noreferrer">{text}</a>
                      : plain ? <span class="experience-role-plain">{text}</span> : text}
                  </>
                );
              })}
            </span>
          </p>
          {entry.logo && (
            <span class="experience-role-logo" style={`--experience-logo: url("${entry.logo}")`} aria-hidden="true"></span>
          )}
        </li>
      );
    })}
  </ol>
  </div>
  {points.length > 0 && (
    <details class="experience-points" name="experience-points">
      <summary class="experience-points-toggle">
        <span class="experience-points-prompt" aria-hidden="true">&gt;</span>
        <span class="experience-points-command">Working on...</span>
      </summary>
      <div class="experience-points-output">
        <div class="experience-points-bar">
          <span>{name}</span>
          <button type="button" class="experience-points-close" aria-label="Close">[x]</button>
        </div>
        {grouped
          ? points.map((group, groupIndex) => (
              <div class="experience-points-group">
                <p class="experience-points-title" style={`--i: ${groupOffsets[groupIndex]}`}>{group.title}</p>
                <ul>
                  {group.items.map((item, index) => (
                    <li style={`--i: ${groupOffsets[groupIndex] + index + 1}`}>
                      {typeof item === 'object' ? (item.href ? <a href={item.href} target="_blank" rel="noopener noreferrer">{item.text}</a> : item.text) : item}
                      {typeof item === 'object' && item.items && (
                        <ul class="experience-points-sub">
                          {item.items.map((sub) => <li style={`--i: ${groupOffsets[groupIndex] + index + 1.5}`}>{sub}</li>)}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          : (
              <ul>
                {points.map((point, index) => (
                  <li style={`--i: ${index}`}>{typeof point === 'object' && point.href ? <a href={point.href} target="_blank" rel="noopener noreferrer">{point.text}</a> : point}</li>
                ))}
              </ul>
            )}
      </div>
    </details>
  )}
  {side && <Astro.self {...side} nested />}
</div>
